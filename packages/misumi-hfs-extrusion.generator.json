 "defaults": {
  "type": "concat(tname, series)",
  "k_l_min": "\"l_min\"",
  "k_l_max": "\"l_max\"",
  "k_l_step": "\"l_step\"",
  "k_fixed_length_1": "\"fixed_length_1\"",
  "k_fixed_length_2": "\"fixed_length_2\""
 },
 "x-early-rules": [
  {
   "when": "type == \"EFS6\" || type == \"EFSB6\" || type == \"EFSC6\" || type == \"EFSF6\" || type == \"EFSH6\" || type == \"EFST6\" || type == \"GFS6\" || type == \"HFSC5\" || type == \"HFSC6\" || type == \"HFSF5\"",
   "refuse": "{type}: valid {series} series type, but not drawn here (drawn: CAF5, CAF6, HFS5, HFS6, HFSB5, HFSB6, HFSY5, HFSY6, NFS5, NFSB5)",
   "kind": "not_modelled"
  },
  {
   "when": "type == \"HFSF6\" || type == \"HFSFB5\" || type == \"HFSFB6\" || type == \"HFSH5\" || type == \"HFSH6\" || type == \"HFSL6\" || type == \"HFSLB6\" || type == \"HFSR5\" || type == \"HFST5\" || type == \"HFST6\"",
   "refuse": "{type}: valid {series} series type, but not drawn here (drawn: CAF5, CAF6, HFS5, HFS6, HFSB5, HFSB6, HFSY5, HFSY6, NFS5, NFSB5)",
   "kind": "not_modelled"
  },
  {
   "when": "type == \"HFSTB5\" || type == \"HFSTB6\" || type == \"NEFS6\" || type == \"NEFSB6\" || type == \"NEFSF6\" || type == \"NEFST6\" || type == \"NFSF5\" || type == \"NFSL6\" || type == \"NFST5\"",
   "refuse": "{type}: valid {series} series type, but not drawn here (drawn: CAF5, CAF6, HFS5, HFS6, HFSB5, HFSB6, HFSY5, HFSY6, NFS5, NFSB5)",
   "kind": "not_modelled"
  }
 ],
 "lookups": [
  {
   "table": "profiles",
   "as": "pr",
   "key": {
    "profile": "profile"
   },
   "missing": "profile {profile} is not available here (drawn: 2020, 2040, 4040, 3030)"
  },
  {
   "table": "types",
   "as": "tp",
   "key": {
    "type": "type",
    "profile": "profile"
   },
   "missing": "{type} is not listed for profile {profile} (unknown type, wrong series, or HFSY5 outside 2020)"
  },
  {
   "table": "params",
   "as": "lmin",
   "key": {
    "name": "k_l_min"
   }
  },
  {
   "table": "params",
   "as": "lmax",
   "key": {
    "name": "k_l_max"
   }
  },
  {
   "table": "params",
   "as": "lstep",
   "key": {
    "name": "k_l_step"
   }
  },
  {
   "table": "params",
   "as": "fl1",
   "key": {
    "name": "k_fixed_length_1"
   }
  },
  {
   "table": "params",
   "as": "fl2",
   "key": {
    "name": "k_fixed_length_2"
   }
  }
 ],
 "vars": [
  {
   "name": "code",
   "expr": "code_in"
  },
  {
   "name": "fixed",
   "expr": "k == \"K\""
  },
  {
   "name": "type_full",
   "expr": "concat(k, type)"
  },
  {
   "name": "tapL",
   "expr": "in(\"LTP\", options) || in(\"TPW\", options)"
  },
  {
   "name": "tapR",
   "expr": "in(\"RTP\", options) || in(\"TPW\", options)"
  },
  {
   "name": "rowsL",
   "expr": "(in(\"LCH\", options) || in(\"LCV\", options)) ? 1 : ((in(\"LWH\", options) || in(\"LWV\", options)) ? 2 : ((in(\"LEH\", options) || in(\"LEV\", options)) ? 3 : 0))"
  },
  {
   "name": "cntL",
   "expr": "if(in(\"LCH\", options), 1, 0) + if(in(\"LCV\", options), 1, 0) + if(in(\"LWH\", options), 1, 0) + if(in(\"LWV\", options), 1, 0) + if(in(\"LEH\", options), 1, 0) + if(in(\"LEV\", options), 1, 0)"
  },
  {
   "name": "orientL",
   "expr": "(in(\"LCH\", options) || in(\"LWH\", options) || in(\"LEH\", options)) ? \"H\" : \"V\""
  },
  {
   "name": "h0L",
   "expr": "pr.wrench_h - (in(\"FL\", options) ? 3 : 0)"
  },
  {
   "name": "lastL",
   "expr": "h0L + (rowsL >= 2 ? pr.wrench_j : 0) + (rowsL >= 3 ? pr.wrench_k : 0)"
  },
  {
   "name": "rowsR",
   "expr": "(in(\"RCH\", options) || in(\"RCV\", options)) ? 1 : ((in(\"RWH\", options) || in(\"RWV\", options)) ? 2 : ((in(\"REH\", options) || in(\"REV\", options)) ? 3 : 0))"
  },
  {
   "name": "cntR",
   "expr": "if(in(\"RCH\", options), 1, 0) + if(in(\"RCV\", options), 1, 0) + if(in(\"RWH\", options), 1, 0) + if(in(\"RWV\", options), 1, 0) + if(in(\"REH\", options), 1, 0) + if(in(\"REV\", options), 1, 0)"
  },
  {
   "name": "orientR",
   "expr": "(in(\"RCH\", options) || in(\"RWH\", options) || in(\"REH\", options)) ? \"H\" : \"V\""
  },
  {
   "name": "h0R",
   "expr": "pr.wrench_h - (in(\"FR\", options) ? 3 : 0)"
  },
  {
   "name": "lastR",
   "expr": "h0R + (rowsR >= 2 ? pr.wrench_j : 0) + (rowsR >= 3 ? pr.wrench_k : 0)"
  },
  {
   "name": "hasW",
   "expr": "rowsL > 0 || rowsR > 0"
  },
  {
   "name": "xany",
   "expr": "in(\"X5\", options) || in(\"X8\", options)"
  },
  {
   "name": "wd",
   "expr": "pr.wrench_d > 0 ? pr.wrench_d : (in(\"X5\", options) ? 5 : (in(\"X8\", options) ? 8 : 0))"
  },
  {
   "name": "tap_txt",
   "expr": "(tapL || tapR) ? concat(\", end tapped \", pr.tap_thread, \" depth \", pr.tap_depth, \" (\", (tapL && tapR) ? \"both ends\" : (tapL ? \"left end\" : \"right end\"), \")\") : \"\""
  },
  {
   "name": "wtxtL",
   "expr": "rowsL > 0 ? concat(\", left wrench access holes x\", rowsL, \" \", orientL == \"H\" ? \"horizontal\" : \"vertical\", \" d\", wd) : \"\""
  },
  {
   "name": "wtxtR",
   "expr": "rowsR > 0 ? concat(\", right wrench access holes x\", rowsR, \" \", orientR == \"H\" ? \"horizontal\" : \"vertical\", \" d\", wd) : \"\""
  },
  {
   "name": "desc",
   "expr": "concat(\"MISUMI aluminium extrusion \", type_full, \"-\", profile, \" \", lower(tp.surface), \", \", tp.material, \", L=\", length, \" mm\", tap_txt, wtxtL, wtxtR, \". Generated from the published catalogue dimensions.\")"
  },
  {
   "name": "mat",
   "expr": "concat(tp.material, \", \", tp.surface)"
  }
 ],
 "rules": [
  {
   "when": "fixed && len(options) > 0",
   "refuse": "alterations apply to configurable-length extrusions only (fixed-length K types have none)"
  },
  {
   "when": "fixed && length != fl1.value && length != fl2.value",
   "refuse": "fixed-length (K) extrusions come only in {fl1.value}, {fl2.value} mm, not {length}"
  },
  {
   "when": "!fixed && (length < lmin.value || length > lmax.value)",
   "refuse": "length {length} mm outside {lmin.value}-{lmax.value} mm"
  },
  {
   "when": "!fixed && abs(length / lstep.value - round(length / lstep.value)) > 0.000000001",
   "refuse": "length {length} mm is not a multiple of {lstep.value} mm"
  },
  {
   "when": "(in(\"LTP\", options) || in(\"RTP\", options)) && in(\"TPW\", options)",
   "refuse": "end tapping given twice for the same end"
  },
  {
   "when": "in(\"LHP\", options) || in(\"RHP\", options) || in(\"HPW\", options)",
   "refuse": "heli-coil end tapping (LHP / RHP / HPW): parsed, not modelled",
   "kind": "not_modelled"
  },
  {
   "when": "in(\"LCP\", options) || in(\"LWP\", options) || in(\"LEP\", options) || in(\"RCP\", options) || in(\"RWP\", options) || in(\"REP\", options)",
   "refuse": "crisscross (P) wrench-hole layout is ambiguous in the catalogue text; use H or V",
   "kind": "not_modelled"
  },
  {
   "when": "cntL > 1",
   "refuse": "two wrench-hole options for the left end"
  },
  {
   "when": "cntR > 1",
   "refuse": "two wrench-hole options for the right end"
  },
  {
   "when": "in(\"X5\", options) && in(\"X8\", options)",
   "refuse": "X5 and X8 are both given (the package refuses; the Python generator takes the last)"
  },
  {
   "when": "hasW && pr.wrench_d > 0 && xany",
   "refuse": "X5/X8 (wrench hole diameter) applies to the 6 series; the 5 series hole is d{pr.wrench_d}"
  },
  {
   "when": "hasW && pr.wrench_d == 0 && !xany",
   "refuse": "the 6 series wrench hole diameter is selectable: add -X5 or -X8 (S3 p.759 footnote)"
  },
  {
   "when": "!hasW && xany",
   "refuse": "X5/X8 sets the wrench hole diameter; there is no wrench hole alteration in this code"
  },
  {
   "when": "in(\"FL\", options) && rowsL == 0",
   "refuse": "FL shifts a wrench hole on the left end, but there is none"
  },
  {
   "when": "in(\"FR\", options) && rowsR == 0",
   "refuse": "FR shifts a wrench hole on the right end, but there is none"
  },
  {
   "when": "in(\"SC\", options) && length > 1500",
   "refuse": "SC (high precision cut) applies to L <= 1500 mm only"
  },
  {
   "when": "in(\"CW\", options)",
   "refuse": "CW: End face C chamfer (thread chamfer C0.2-0.3): not modelled",
   "kind": "not_modelled"
  },
  {
   "when": "(tapL || tapR) && 2 * pr.tap_depth > length",
   "refuse": "tapped holes overlap"
  },
  {
   "when": "rowsL > 0 && (h0L - wd / 2 < 0 || lastL + wd / 2 > length)",
   "refuse": "wrench holes of the left end do not fit in a {length} mm length"
  },
  {
   "when": "rowsR > 0 && (length - lastR - wd / 2 < 0 || h0R - wd / 2 < 0)",
   "refuse": "wrench holes of the right end do not fit in a {length} mm length"
  }
 ],
 "steps": [
  {
   "command": "sketch.create",
