  },
  {
   "command": "sketch.circle.center",
   "params": {
    "center": "${at(pr.b4_c, 0)}",
    "diameter": "${pr.b4_d}"
   },
   "when": "len(pr.b4_c) > 0"
  },
  {
   "command": "sketch.finish",
   "params": {}
  },
  {
   "command": "solid.extrude",
   "params": {
    "distance": "${length}",
    "name": "Extrusion",
    "body_name": "${code}"
   }
  },
  {
   "command": "solid.cylinder",
   "params": {
    "diameter": "${wd}",
    "height": "${orientL == \"H\" ? pr.w + 2 : pr.h + 2}",
    "base": [
     "${(i == 0 ? h0L : (i == 1 ? h0L + pr.wrench_j : h0L + pr.wrench_j + pr.wrench_k))}",
     "${orientL == \"H\" ? -pr.w / 2 - 1 : 0}",
     "${orientL == \"H\" ? 0 : -pr.h / 2 - 1}"
    ],
    "axis": "${orientL == \"H\" ? \"Y\" : \"Z\"}",
    "operation": "cut",
    "targets": [
     "${code}"
    ],
    "name": "Wrench hole L${i + 1}"
   },
   "when": "rowsL > 0",
   "repeat": {
    "var": "i",
    "count": "rowsL",
    "max": 3
   }
  },
  {
   "command": "solid.cylinder",
   "params": {
    "diameter": "${wd}",
    "height": "${orientR == \"H\" ? pr.w + 2 : pr.h + 2}",
    "base": [
     "${(length - (i == 0 ? h0R : (i == 1 ? h0R + pr.wrench_j : h0R + pr.wrench_j + pr.wrench_k)))}",
     "${orientR == \"H\" ? -pr.w / 2 - 1 : 0}",
     "${orientR == \"H\" ? 0 : -pr.h / 2 - 1}"
    ],
    "axis": "${orientR == \"H\" ? \"Y\" : \"Z\"}",
    "operation": "cut",
