#!/usr/bin/env bash
# Refuse a push whose files or commit messages carry personal paths, session text or private words (tools/lint, tools/privacy).
# Install once per clone: git config core.hooksPath tools/hooks
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
"$root/tools/lint" >/dev/null || { "$root/tools/lint" | tail -n 20; echo "pre-push: tools/lint refused"; exit 1; }
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                     # deleting a branch
  if [ "$rsha" = "$zero" ]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
  # shellcheck disable=SC2086
  "$root/tools/privacy" -- $range >/dev/null 2>&1 || { "$root/tools/privacy" -- $range || true; echo "pre-push: refused"; exit 1; }
done
