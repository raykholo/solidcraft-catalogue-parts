#!/usr/bin/env python3
"""tools/provenance [GENERATOR_DIR ...] [--check]: write PROVENANCE.md of each generator from sources.toml, data/, checks/ and the
manifest (never by hand). --check writes nothing and exits 1 when a PROVENANCE.md is missing or out of date."""
import argparse, sys
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from runtime import registry, provenance

ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
ap.add_argument("dirs", nargs="*"); ap.add_argument("--check", action="store_true")
a = ap.parse_args()
gens = registry.generators()
if a.dirs:
    want = {Path(d).resolve() for d in a.dirs}
    gens = [g for g in gens if g.dir.resolve() in want]
stale = 0
for g in gens:
    text = provenance.render(g)
    f = g.dir / "PROVENANCE.md"
    if a.check:
        if not f.exists() or f.read_text() != text:
            print(f"STALE  {f.relative_to(ROOT)}"); stale += 1
    else:
        f.write_text(text)
        level, why = provenance.badge(g)
        print(f"wrote {f.relative_to(ROOT)}  level: {level or 'none (' + why + ')'}")
sys.exit(1 if stale else 0)
