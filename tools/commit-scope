#!/usr/bin/env python3
"""tools/commit-scope [--] REVS...: a commit that touches files of exactly one generator folder (vendors/<vendor>/<series>/<generator>/)
and nothing else must have a subject that starts with that generator's id or a dotted prefix of it, then a colon:
`misumi.hfs.extrusion: ...` or `misumi.hfs: ...` or `misumi: ...`. Commits that touch shared code (runtime/, tools/, docs/, workflows,
README ...) or several generators are free-form, and so are merge commits. Check only the range you are given (new commits); history is
never rewritten. Used by the pre-push hook and by the privacy workflow. See docs/repository-layout.md. Exit 1 on a find."""
import re, subprocess, sys, tomllib
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent
args = [a for a in sys.argv[1:] if a != "--"]
if not args or args[0] in ("-h", "--help"):
    sys.exit(__doc__)

def git(*a):
    return subprocess.run(["git", "-C", str(ROOT), *a], capture_output=True, text=True, check=True).stdout

def generator_id(folder: str, sha: str) -> str:
    """The id in the folder's generator.toml in that commit, or (the folder was deleted) in its first parent; else dotted from the path."""
    for rev in (sha, sha + "^"):
        r = subprocess.run(["git", "-C", str(ROOT), "show", f"{rev}:{folder}/generator.toml"], capture_output=True, text=True)
        if r.returncode == 0:
            return tomllib.loads(r.stdout)["id"]
    return folder.split("/", 1)[1].replace("/", ".")

bad = checked = 0
for sha in git("rev-list", "--no-merges", *args).split():
    files = git("diff-tree", "--no-commit-id", "--name-only", "-r", "--root", "-z", sha).split("\0")
    files = [f for f in files if f]
    gens = {"/".join(f.split("/")[:4]) for f in files if re.match(r"vendors/[^/]+/[^/]+/[^/]+/", f)}
    if len(gens) != 1 or any(not f.startswith(next(iter(gens)) + "/") for f in files):
        continue
    checked += 1
    folder = next(iter(gens)); gid = generator_id(folder, sha)
    subject = git("log", "-1", "--format=%s", sha).strip()
    parts = gid.split(".")
    ok = any(subject.startswith(".".join(parts[:n]) + ":") for n in range(1, len(parts) + 1))
    if not ok:
        bad += 1
        print(f"{sha[:10]}: touches only {folder}/, so its subject must start with `{gid}:` (or a prefix such as `{parts[0]}.{parts[1]}:`); got: {subject!r}")
print(f"commit-scope: {checked} single-generator commit(s) checked, {bad} problem(s)")
sys.exit(1 if bad else 0)
