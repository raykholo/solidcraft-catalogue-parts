    def rows(self, refusal, refuse=None):
        refusal_parameter = refuse["parameter"] if refuse else "length"
        a = {"configuration": "row", "parameters": {"length": "400 mm", "caps": "0"}}
        b = {"configuration": "row", "parameters": {"length": "300 mm", "caps": "0"}}
        with tempfile.TemporaryDirectory() as tmp, patch.object(links, "resolve", side_effect=[a, b]), \
                patch.object(links, "direct", return_value=M) as direct, patch.object(links, "measure", return_value=M), \
                patch.object(links, "cli", side_effect=[([{"component": 73}], None), ([], None), (None, refusal), ([{"rules": [{"id": f"{refusal_parameter} range", "effect": {"parameter": refusal_parameter}}]}], None)]) as call:
            rows = links.link_rows(None, Path(tmp), Path(tmp) / "part.sc",
                                   {"parameter": "length", "insert": "A", "change": "B", "outside": "3000 mm", **({"refuse": refuse} if refuse else {})}, Path(tmp))
            calls = call.call_args_list
            self.assertNotIn("src", calls[0].kwargs)  # empty assembly
            self.assertEqual(calls[0].args[0][0]["params"]["parameters"], a["parameters"])
            self.assertEqual(calls[1].args[0][0]["params"], {"component": 73, "parameters": {"length": "300 mm"}, "merge": True})
            self.assertEqual(calls[1].kwargs["src"], calls[0].kwargs["save"])
            self.assertEqual(calls[2].args[0][0]["params"]["parameters"],
                             {refusal_parameter: refuse["outside"] if refuse else "3000 mm"})
            self.assertEqual([c.args[1] for c in direct.call_args_list], ["A", "B"])
            return rows

