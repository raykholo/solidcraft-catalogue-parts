    def test_package_manifest_keys_match_native_structs(self):
        import tomllib
        allowed = {"top": set("format id name description license author model min_solidcraft script row_from parameters template rows example".split()),
                   "parameters": set("type values labels codes min max step digits unit default escape".split()),
                   "template": set("pattern description fields".split()),
                   "rows": set("source page status note description".split()),
                   "example": set("code invalid message_contains volume_mm3 bbox_mm faces".split())}
        packages = list(ROOT.glob("vendors/*/*/*/parametric/*/generator.toml"))
        self.assertEqual(len(packages), 18)
        for path in packages:
            data = tomllib.loads(path.read_text())
            self.assertFalse(data.keys() - allowed["top"], path)
            for group in ("parameters", "template", "rows", "example"):
                items = data.get(group, {})
                for item in items.values() if isinstance(items, dict) else items:
                    self.assertFalse(item.keys() - allowed[group], (path, group))
            templates = fieldtemplate.load(path.parent)
            for template in templates.templates:
                self.assertNotIn("bag(", template.pattern)

    def test_text_escape_is_declared_and_not_template_level(self):
        with tempfile.TemporaryDirectory() as tmp:
            path = Path(tmp) / "generator.toml"
            path.write_text('[parameters]\nx = {type="text", min=1, max=8, escape="[A-Za-z0-9+/]"}\n[[template]]\npattern="X{x}"\n')
            templates = fieldtemplate.load(tmp)
            self.assertEqual(templates.match("XAB/C+1")[1]["x"], "AB/C+1")
            self.assertIsNone(templates.match("XAB!"))
            path.write_text(path.read_text() + 'escape="[A-Z]"\n')
            with self.assertRaises(fieldtemplate.TemplateError):
                fieldtemplate.load(tmp)
        with self.assertRaises(fieldtemplate.TemplateError):
            fieldtemplate.Template.parse("X{x: text 1..8 [A-Z]}")

