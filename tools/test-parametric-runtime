    def test_native_parse_valid_reference_and_errors(self):
        from runtime.parametric import native_parse as native
        value = {"configuration": "row", "parameters": {"length": "300 mm"}}
        line = SimpleNamespace(code="VALID", valid=True)
        for reply in [value | {"ok": True}, {"ok": False, "message": "package invalid"}]:
            with patch.object(native, "resolve", return_value=value), patch.object(native, "cli", return_value=([reply], None)) as call:
                row = native.parse_row(ROOT, line, {})
                self.assertEqual(row["expected"], value)
                self.assertEqual(call.call_args.args[0][0]["params"]["code"], "VALID")
                self.assertEqual(row["expected"] == row["actual"], reply["ok"])
        with patch.object(native, "resolve", side_effect=ValueError("reference failed")), patch.object(native, "cli", return_value=([value | {"ok": True}], None)) as call:
            row = native.parse_row(ROOT, line, {})
