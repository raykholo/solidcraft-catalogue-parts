                {"label": "failure", "error": "exact error"}],
                "insert": {"label": "insertion", "direct": raw, "changed": raw}}))
            out = convert_hiwin(path, "hiwin.eg.guideway", [], True)
            self.assertEqual([r["label"] for r in out["rebuild"]], [
                "change (the fresh parametric instance)", "change (the Python part)", "failure", "insertion"])
            self.assertEqual(out["rebuild"][0]["direct"]["bbox"], [-2, 0, 1, 1, 4, 6])
            self.assertEqual(out["rebuild"][2]["changed"], {"error": True})

    def test_hiwin_absolute_bounds_unchanged(self):
        raw = {"vol": 42, "area": 20, "faces": 6, "bodies": 1, "lo": [-2, 0, 1], "hi": [1, 4, 6]}
        with tempfile.TemporaryDirectory() as tmp:
            (Path(tmp) / "report.json").write_text(json.dumps([{"code": "MGN", "python_m": raw, "param_m": raw, "pycheck": "1/1", "check": "1/1"}]))
            out = convert_hiwin(tmp)
            self.assertEqual(out["valid"][0]["python"]["bbox"], [-2, 0, 1, 1, 4, 6])


