#!/usr/bin/env python3
"""Screenshots of built parts in the real SolidCraft window (Xvfb, control channel), English and German, 1280x800.

    tools/shots CODE [CODE ...] [--out-dir DIR] [--langs en,de]
    tools/shots --all                       every generator's preview_code (generator.toml)

Writes <generator>/shots/<code>[-<view>]-<lang>.png (or into --out-dir). Each generator's src/shots.py gives `scene(code)` (the part
and command list to show; shots-only extras such as a base plate belong there, never in the part) and `views(part)` (camera per
shot). Needs the SolidCraft desktop binary (SC_APP / SC_RELEASES), Xvfb and ImageMagick `import` (SC_SHOTS_TOOLS=<prefix> adds
<prefix>/bin to PATH and <prefix>/lib64 to LD_LIBRARY_PATH). HOME=/tmp/demo keeps paths neutral; Donate and Discord buttons are
hidden through ui.prefs (show_donate_button, show_discord_button = false). One run at a time: a lock file serialises them.
"""
import argparse, fcntl, json, os, shutil, signal, socket, subprocess, sys, time
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from runtime import registry, sc

TOKEN = "p1" + "ab12cd34" * 7 + "ef"
PORT, DISP = 47381, ":281"
DEMO = "/tmp/demo"
LOCK = "/tmp/sc-parts-shots.lock"

def call(method, params=None, i=[0], timeout=90):
    s = socket.create_connection(("127.0.0.1", PORT), timeout=timeout)
    i[0] += 1
    s.sendall((json.dumps({"id": i[0], "token": TOKEN, "method": method, "params": params or {}}) + "\n").encode())
    b = b""
    while not b.endswith(b"\n"):
        c = s.recv(65536)
        if not c: break
        b += c
    s.close()
    return json.loads(b)

def dismiss_toast():
    try:
        for h in call("ui.handles", {})["result"]:
            if h["name"] == "toast:usage_stats:close":
                call("ui.click", {"x": h["x"], "y": h["y"]}); time.sleep(1); return
    except Exception as ex:
        print("toast", ex)

def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[1])
    ap.add_argument("codes", nargs="*"); ap.add_argument("--out-dir"); ap.add_argument("--langs", default="en,de")
    ap.add_argument("--all", action="store_true", help="every generator's preview_code")
    a = ap.parse_args()
    if a.all:
        a.codes = a.codes + [g.manifest["preview_code"] for g in registry.generators() if g.manifest.get("preview_code")]
    if not a.codes:
        ap.error("give codes or --all")
    langs = a.langs.split(",")
    tools = os.environ.get("SC_SHOTS_TOOLS", "")
    env = dict(os.environ, DISPLAY=DISP, HOME=DEMO, XDG_CONFIG_HOME=f"{DEMO}/xdg/config", XDG_DATA_HOME=f"{DEMO}/xdg/data",
               XDG_CACHE_HOME=f"{DEMO}/xdg/cache", XDG_STATE_HOME=f"{DEMO}/xdg/state", SOLIDCRAFT_CONTROL_TOKEN=TOKEN, GDK_BACKEND="x11")
    if tools:
        env["PATH"] = f"{tools}/bin:" + env["PATH"]; env["LD_LIBRARY_PATH"] = f"{tools}/lib64"
    env.pop("WAYLAND_DISPLAY", None)
    lock = open(LOCK, "w"); fcntl.flock(lock, fcntl.LOCK_EX)
    shutil.rmtree(DEMO, ignore_errors=True)
    for d in ("designs", "xdg/config", "xdg/data", "xdg/cache", "xdg/state"):
        os.makedirs(f"{DEMO}/{d}")
    xvfb = f"{tools}/bin/Xvfb" if tools else "Xvfb"
    xv = subprocess.Popen([xvfb, DISP, "-screen", "0", "1280x800x24", "-nolisten", "tcp"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(2)
    app = subprocess.Popen(["dbus-run-session", "--", sc.APP, "--control", str(PORT), "--new-instance"], env=env,
                           stdout=open(f"{DEMO}/app.log", "w"), stderr=subprocess.STDOUT, start_new_session=True)
    try:
        for _ in range(60):
            try:
                call("engine.execute", {"command": "inspect.measure", "params": {}}); break
            except Exception:
                time.sleep(1)
        for code in a.codes:
            g = registry.find(code)
            sm = g.module("shots")
            part, cmds = sm.scene(code)
            path, _ = sc.run_script(cmds, f"{DEMO}/designs", sc.slug(code))
            outdir = Path(a.out_dir) if a.out_dir else g.dir / "shots"
            outdir.mkdir(parents=True, exist_ok=True)
            for lang in langs:
                print("open", json.dumps(call("engine.execute", {"command": "doc.open", "params": {"path": path}}))[:200]); time.sleep(4)
                call("ui.set", {"tab": "model"})
                r = call("ui.prefs", {"language": "de" if lang == "de" else "en", "show_donate_button": False, "show_discord_button": False})
                print("prefs", json.dumps(r)[:300] if "error" in r else "ok")
                call("engine.execute", {"command": "select.clear", "params": {}})
                dismiss_toast()
                for suffix, cam in sm.views(part):
                    call("ui.camera", cam); time.sleep(2)
                    call("ui.move", {"x": 5, "y": 795}); time.sleep(1)       # pointer off the model: hover outlines draw through bodies
                    out = (outdir / f"{sc.slug(code)}{'-' + suffix if suffix else ''}-{lang}.png").resolve()
                    subprocess.run(["import", "-window", "root", str(out)], env=env, check=True); print(out)
    finally:
        try: os.killpg(app.pid, signal.SIGTERM)
        except ProcessLookupError: pass
        time.sleep(1); xv.terminate()

if __name__ == "__main__":
    main()
