{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "generator.toml",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "kind",
    "min_host_version",
    "preview_code",
    "entry",
    "declares",
    "inputs",
    "guarantee"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*){2}$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "generator"
      ]
    },
    "min_host_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "preview_code": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "object",
      "required": [
        "build",
        "check",
        "shots"
      ],
      "properties": {
        "build": {
          "type": "string",
          "pattern": "^[a-z_]+(:[a-z_]+)?$"
        },
        "check": {
          "type": "string",
          "pattern": "^[a-z_]+(:[a-z_]+)?$"
        },
        "shots": {
          "type": "string",
          "pattern": "^[a-z_]+(:[a-z_]+)?$"
        }
      }
    },
    "declares": {
      "type": "object",
      "required": [
        "labels",
        "keywords",
        "vendor",
        "matches"
      ],
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coexists": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "generator",
              "pattern",
              "confidence",
              "examples",
              "negative_examples"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "generator": {
                "type": "string"
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "flags": {
                "type": "string",
                "pattern": "^i?$"
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "exact",
                  "prefix",
                  "possible"
                ]
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "negative_examples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object"
    },
    "guarantee": {
      "type": "object",
      "required": [
        "not_guaranteed"
      ],
      "properties": {
        "not_guaranteed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
