{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources.toml",
  "type": "object",
  "required": [
    "source",
    "dimension"
  ],
  "properties": {
    "meta": {
      "type": "object"
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "catalogue",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d+$"
          },
          "catalogue": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "pages": {
            "type": "string"
          },
          "private_reference": {
            "type": "boolean"
          }
        }
      }
    },
    "dimension": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "item",
          "source",
          "page",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "item": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^S\\d+$"
            }
          },
          "source_text": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "labelled",
              "measured",
              "published",
              "derived",
              "approximate",
              "none"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "note": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
