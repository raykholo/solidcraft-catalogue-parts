format = "solidcraft-generator/2"
id = "hg-guideway"
name = "HIWIN HG linear guideway: rail, block or rail with blocks"
license = "CC0-1.0"
model = "hg-guideway.sc"
min_solidcraft = "0.52.0"

# Ordering codes, HIWIN Linear Guideway catalogue G99TE24-2410, HG series, section 2-1-3:
#   set    HG W 25 C A E 2 R 1600 E ZA P M II + DD/E2+RC     rail with blocks (rail mounted from the top R or from the bottom T)
#   rail   HGR 25 R 1600 E P M + ...                          rail alone
#   block  HG W 25 C A E ZA P M + ...                         block alone (interchangeable)
# Size and number of blocks are plain fields and the rest is checked in generator.rhai, so that every refusal carries the Python
# generator's wording. `length` is the free parameter of the model, `blocks` the other one.
[parameters]
length = { type = "decimal", min = 40, max = 4000, unit = "mm" }
blocks = { type = "int", min = 1, max = 99, default = 1 }

[[template]]
pattern = "HGR{size: text 2..2 [0-9]}{rm: R|T}{length: decimal 0..99999}[E:erail][{prec: SP|UP|C|H|P}][{mat: M}][+{opt: text 1..64}]"
escape  = "[A-Za-z0-9+/]+"
description = "HGR{size}{rm} rail, {length} mm"

[[template]]
pattern = "HG{kind: H|W|L}{size: text 2..2 [0-9]}{load: C|H}{mount: A|B|C}[E:eblock]{n: int 0..9999}{rm: R|T}{length: decimal 0..99999}[E:erail][{preload: Z0|ZA|ZB}][{prec: SP|UP|C|H|P}][{mat: M}][{rails: I|II|III|IIII}][+{opt: text 1..64}]"
escape  = "[A-Za-z0-9+/]+"
description = "HG{kind}{size}{load}{mount} with {n} block(s) on a {length} mm rail"

[[template]]
pattern = "HG{kind: H|W|L}{size: text 2..2 [0-9]}{load: C|H}{mount: A|B|C}[E:eblock][{preload: Z0|ZA}][{prec: C|H|P}][{mat: M}][+{opt: text 1..64}]"
escape  = "[A-Za-z0-9+/]+"
description = "HG{kind}{size}{load}{mount} block"

# Preserve malformed ordering codes, including decimal spelling, for the Python shape refusal.
[[template]]
pattern = "{raw: text 1..128 [A-Za-z0-9.+/_ -]}"
