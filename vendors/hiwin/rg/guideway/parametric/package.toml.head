format = "solidcraft-generator/2"
id = "rg-guideway"
name = "HIWIN RG roller guideway: rail, block or rail with blocks"
license = "CC0-1.0"
model = "rg-guideway.sc"
min_solidcraft = "0.52.0"

# Ordering codes, HIWIN Linear Guideway catalogue G99TE24-2410, RG series, section 2-9-3:
#   set    RG W 35 C C E 2 R 1640 E ZA P II + KK/E2+RC       rail with blocks
#   rail   RGR 35 R 1640 E P + ...                           rail alone
#   block  RG W 35 C C E ZA P + ...                          block alone (interchangeable)
# The option text after + may hold a dust-protection code (ZZ, DD, KK): it replaces the block length L (Table 2-9-22), a parameter
# override of the row. Size and number of blocks are plain fields and the rest is checked in generator.rhai, so that every refusal
# carries the Python generator's wording. `length` is the free parameter of the model, `blocks` the other one.
[parameters]
length = { type = "decimal", min = 100, max = 4000, unit = "mm" }
blocks = { type = "int", min = 1, max = 99, default = 1 }

[[template]]
pattern = "RGR{size: text 2..2 [0-9]}{rm: R|T}{length: decimal 0..99999}[E:erail][{prec: SP|UP|C|H|P}][{mat: M}][+{opt: text 1..64}]"
escape  = "[A-Za-z0-9+/]+"
description = "RGR{size} rail, {length} mm"

[[template]]
pattern = "RG{kind: H|W|L|S|F}{size: text 2..2 [0-9]}{load: C|H}{mount: A|C}[E:eblock]{n: int 0..9999}{rm: R|T}{length: decimal 0..99999}[E:erail][{preload: Z0|ZA|ZB}][{prec: SP|UP|C|H|P}][{mat: M}][{rails: I|II|III|IIII}][+{opt: text 1..64}]"
escape  = "[A-Za-z0-9+/]+"
description = "RG{kind}{size}{load}{mount} with {n} block(s) on a {length} mm rail"

[[template]]
pattern = "RG{kind: H|W|L|S|F}{size: text 2..2 [0-9]}{load: C|H}{mount: A|C}[E:eblock][{preload: Z0|ZA|ZB}][{prec: SP|UP|C|H|P}][{mat: M}][+{opt: text 1..64}]"
escape  = "[A-Za-z0-9+/]+"
description = "RG{kind}{size}{load}{mount} block"
